# Copy to dev.env (git-ignored). The whole model setup is one JSON value;
# see ai-agent-config.example.json for every field. Multi-line is fine inside single quotes.
ENV=dev
# Postgres holding the backend's `docs` table (same value as ai-agent-management's PG_DB_URL).
# Only read when ai-agent-config has a `rag` section. Prod reads the `pg-db-url` secret (PG_DB_URL_NAME).
PG_DB_URL=
AI_AGENT_CONFIG='{
  "models": [
    {"id": "llama-local", "type": "opensource", "provider": "ollama", "protocol": "openai", "model": "llama3.2:1b",
     "base_url": "http://localhost:11434/v1"}
  ]
}'
